# directory
target/
test_manual/
__pycache__/
*.egg-info/
node_modules/
external/
.pytest_cache/
docs/local/

# files
package-lock.json
wannier90flow/solution_booklet.pdf
wannier90flow/tutorial.pdf
wannier90flow/user_guide.pdf
.vscode/settings.json

# macOS
.DS_Store

# auto-generated test working dirs (QE/VASP/SCFlow run outputs)
test_auto/**/MgB2_calc/
# 跟踪黄金基线 pytest：忽略各 flow 运行时生成目录，仅放行 test_*.py
test_auto/MgB2/qeflow/*
!test_auto/MgB2/qeflow/test_*.py
test_auto/MgB2/scflow/*
!test_auto/MgB2/scflow/test_*.py
test_auto/MgB2/substitutionflow/*
!test_auto/MgB2/substitutionflow/test_*.py
test_auto/MgB2/vaspflow/*
!test_auto/MgB2/vaspflow/test_*.py
test_auto/MgB2/wannier90flow/*
!test_auto/MgB2/wannier90flow/test_*.py
!test_auto/MgB2/scflow/validate_scflow_isif4.py

# local_run：真实运行输出不保留在 Git（输入/脚本/结构/赝势库白名单放行）
test_auto/MgB2/local_run/*
!test_auto/MgB2/local_run/*.toml
!test_auto/MgB2/local_run/*.sh
!test_auto/MgB2/local_run/*.vasp
!test_auto/MgB2/local_run/potcar_lib/
!test_auto/MgB2/local_run/potcar_lib/**

# 本机备份类文件
*.bak

# CodeBuddy project data (local tool state)
.codebuddy/

# 可重建发布制品
dist/
scripts/linux/.sources/

# Python 工具缓存与覆盖率报告
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# 编辑器及 macOS 临时文件
*.swp
*.swo
*~
._*

# Rust 格式化备份及覆盖率产物
*.rs.bk
*.profraw
*.profdata

# 根目录旧 .codex 占位文件；未来同名目录仍可存放共享配置
/.codex
!/.codex/
