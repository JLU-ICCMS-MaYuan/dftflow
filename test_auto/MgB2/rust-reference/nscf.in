&CONTROL
  calculation = 'nscf'
  restart_mode = 'from_scratch'
  prefix = 'Mg1B2'
  outdir = './tmp'
  pseudo_dir = '@WORK@/pp'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0e-6
  etot_conv_thr = 1.0e-7
/

&SYSTEM
  nat  = 3
  ntyp = 2
  ibrav = 4
  A = 3.0736999512
  C = 3.5343999863
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.7
  electron_maxstep = 400
/

ATOMIC_SPECIES
  Mg   24.3050 mg_pbe_v1.4.uspp
  B    10.8100 b_pbe_v1.4.uspp.F.UPF

ATOMIC_POSITIONS {crystal}
  Mg    0.00000000   0.00000000   0.00000000
  B     0.33333334   0.66666669   0.50000000
  B     0.66666663   0.33333331   0.50000000

